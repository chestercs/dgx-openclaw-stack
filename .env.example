# dgx-openclaw-stack settings. `./bootstrap.sh` copies this file to .env,
# fills in every CHANGE_ME secret and asks for the HuggingFace token.
#
# Read by docker compose (container settings) and by config-init, which
# writes openclaw.json and the agent workspaces from it on every
# `docker compose up`. Only what a typical install sets is listed here;
# every other knob, with its default and effect, is in
# docs/reference/configuration.md.
#
# Switches take on/off (true/false, 1/0, yes/no also work). An empty value
# means "use the default".

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------
# Optional services to run: browser (Chromium for the agent), python (code
# sandbox), meshcore (LoRa bridge; needs the radio on USB).
COMPOSE_PROFILES=browser,python
# Extra compose files, colon-separated, e.g. another model:
#   COMPOSE_FILE=docker-compose.yml:compose/gemma4.yml
# Options: compose/gemma4.yml, compose/mistral.yml, compose/tts-fish.yml,
# compose/claw-img.yml, compose/strata.yml, compose/strata-llm.yml,
# compose/strata-router.yml (each file says what it needs).
# COMPOSE_FILE=docker-compose.yml
TZ=UTC

# ---------------------------------------------------------------------------
# Host paths (bootstrap.sh creates them; they must be writable by UID 1000)
# ---------------------------------------------------------------------------
# OpenClaw state: openclaw.json, sessions, agent workspaces.
OPENCLAW_CONFIG_DIR=/srv/openclaw/state
# The main agent's workspace.
OPENCLAW_WORKSPACE_DIR=/srv/openclaw/state/workspace
# Files the agent generates or downloads and attaches to replies.
OPENCLAW_CANVAS_DIR=/srv/openclaw/canvas
# Files users send in (Discord attachments).
OPENCLAW_MEDIA_INBOUND_DIR=/srv/openclaw/media/inbound
# Shared by the agent and the python sandbox.
OPENCLAW_SANDBOX_DIR=/srv/openclaw/sandbox
# Model weights (~100 GB with the default model).
VLLM_HF_CACHE_DIR=/srv/openclaw/hf-cache

# ---------------------------------------------------------------------------
# Secrets (generated by bootstrap.sh; rotate with ./rotate-secrets.sh)
# ---------------------------------------------------------------------------
VLLM_API_KEY=CHANGE_ME
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
SEARXNG_SECRET=CHANGE_ME
STT_API_TOKEN=CHANGE_ME
BROWSER_API_TOKEN=CHANGE_ME
BROWSER_VNC_PASSWORD=CHANGE_ME
PYTHON_SANDBOX_API_TOKEN=CHANGE_ME
# Read access is enough; accept the model's licence on its HF page first.
HUGGING_FACE_HUB_TOKEN=hf_CHANGE_ME

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# The id vLLM serves and OpenClaw uses. Change it together with COMPOSE_FILE
# when you switch model files.
LLM_MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Clients that reach the gateway directly (not through a reverse proxy),
# e.g. your LAN, so it trusts their address headers.
# OPENCLAW_LAN_CIDR=192.168.1.0/24
# Time zone for heartbeat hours and dreaming.
OPENCLAW_HEARTBEAT_TZ=UTC

# ---------------------------------------------------------------------------
# Discord (docs/discord-bot-setup.md)
# ---------------------------------------------------------------------------
# Used once by `openclaw channels add --channel discord` during setup.
DISCORD_BOT_TOKEN=
# Your Discord user ID. Owner-only commands, exec approvals and the
# heartbeat DM go to it.
OPENCLAW_DISCORD_COMMAND_OWNERS=
# Names used in the bot's prompt examples (comma-separated) and the admin's
# display name; without them neutral placeholders are used.
# OPENCLAW_DISCORD_MEMBER_NAMES=
# OPENCLAW_DISCORD_ADMIN_NAME=
# OPENCLAW_DISCORD_ADMIN_ID=
# The bot answers only when tagged or replied to. Channel IDs listed here
# get an answer to every message instead (off = none).
OPENCLAW_DISCORD_ALWAYS_CHANNELS=off
# Media tools are off by default; they need the ComfyUI bridge
# (openclaw-image-comfyui/). none = all on.
# OPENCLAW_DISCORD_MEDIA_TOOLS_OFF=image,video,music

# ---------------------------------------------------------------------------
# Python sandbox
# ---------------------------------------------------------------------------
# Public URL of the sandbox preview port (8095), where web apps the agent
# builds are served.
# OPENCLAW_SANDBOX_PUBLIC_URL=https://sandbox.example.com
# GitHub token for the agent's git_push tool (classic token with repo scope).
# GITHUB_TOKEN=
