# GB10: drop the clean page cache, on request. llm-ensure.sh starts this before Strata (compose/strata.yml).
#
# Why: on the GB10's unified memory cudaMalloc does not reclaim the page cache, and Strata sizes its GPU expert
# tier once, at start, from what is free then. Measured beside the stack after hours of uptime (16-26 GB of
# cache): 9,972 experts on the GPU without a drop, 11,109 with one. Right after boot the cache is small and the
# drop adds little (9,949 -> 10,112); there the stack's services are not swapped out yet, which a drop cannot
# change. Only clean pages are dropped (echo 1); nothing is lost, files are read back from disk when used.
#
# gb10-drop-caches.rules lets the docker group start this one unit without a password (that group can already
# do anything as root through docker; this is the narrow, logged way).
# Install:
#   sudo cp scripts/gb10-drop-caches.service /etc/systemd/system/
#   sudo cp scripts/gb10-drop-caches.rules /etc/polkit-1/rules.d/50-gb10-drop-caches.rules
#   sudo systemctl daemon-reload
# Check: systemctl start gb10-drop-caches   (no password prompt)
[Unit]
Description=Drop the clean page cache (GB10: before Strata sizes its GPU tier)

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sync; echo 1 > /proc/sys/vm/drop_caches'
